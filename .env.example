# Copy this file to .env and fill in real values. NEVER commit .env.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
# true = the app runs on synthetic mock datasets (clearly labelled in the UI)
USE_MOCK_DATA=true

# --- Database (local PostgreSQL + PostGIS on Windows) ---
# Password rule: English letters and digits ONLY (no symbols, no non-English
# characters). Paste it as-is, with no URL encoding. See docs/setup/postgresql-windows.md, step 5.
DATABASE_URL=postgresql+psycopg://astera:CHANGE_ME@localhost:5432/astera_watch
# Separate database used only by automated tests (pytest)
TEST_DATABASE_URL=postgresql+psycopg://astera:CHANGE_ME@localhost:5432/astera_watch_test

# --- File storage (satellite files live on disk, not in PostgreSQL) ---
DATA_DIR=./data
MAX_UPLOAD_MB=500

# --- Frontend / CORS ---
CORS_ORIGINS=http://localhost:5173
# Used by the Vite frontend (frontend/.env)
VITE_API_BASE_URL=http://localhost:8000

# --- External data sources (optional; leave empty to use mock data) ---
FIRMS_MAP_KEY=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
CDSE_USERNAME=
CDSE_PASSWORD=

# --- Chatbot (optional; server-side only, never exposed to the frontend) ---
# none = rule-based assistant using the knowledge base + analysis results
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
