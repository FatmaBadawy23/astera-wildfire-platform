# Frontend configuration (copy to frontend/.env.local if you need to change anything).
# Only VITE_* variables reach the browser. NEVER put secrets or API keys here.

# Data source for the UI: "mock" (synthetic, clearly labelled) or "api" (FastAPI backend, Stage 7)
VITE_DATA_MODE=mock

# FastAPI base URL (used only when VITE_DATA_MODE=api)
VITE_API_BASE_URL=http://localhost:8000

# Optional online basemap style URL. Empty = offline Natural Earth country boundaries only.
VITE_BASEMAP_STYLE_URL=
